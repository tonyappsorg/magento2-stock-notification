<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store/etc/config.xsd">
    <default>
        <tonyapps_stocknotification>
            <general>
                <enabled>1</enabled>
                <guest_enabled>1</guest_enabled>
                <popup_enabled>1</popup_enabled>
            </general>
            <admin>
                <notify_new_subscription>0</notify_new_subscription>
                <notify_low_stock>1</notify_low_stock>
            </admin>
            <email>
                <guest_stock_template>tonyapps_stocknotification_email_guest_stock_template</guest_stock_template>
                <guest_price_template>tonyapps_stocknotification_email_guest_price_template</guest_price_template>
                <admin_subscription_template>tonyapps_stocknotification_email_admin_subscription_template</admin_subscription_template>
                <admin_low_stock_template>tonyapps_stocknotification_email_admin_low_stock_template</admin_low_stock_template>
                <guest_confirm_template>tonyapps_stocknotification_email_guest_confirm_template</guest_confirm_template>
            </email>
        </tonyapps_stocknotification>
    </default>
</config>
