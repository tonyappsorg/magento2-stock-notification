<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Core cron handles customer alerts; this one covers guests. -->
        <job name="tonyapps_stocknotification_guest_alerts" instance="Tonyapps\StockNotification\Model\GuestAlertSender" method="send">
            <schedule>*/15 * * * *</schedule>
        </job>
        <job name="tonyapps_stocknotification_low_stock" instance="Tonyapps\StockNotification\Cron\LowStockDigest" method="execute">
            <schedule>0 7 * * *</schedule>
        </job>
    </group>
</config>
