<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Stop alerts</title>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="tonyapps.stocknotification.guest.unsubscribe"
                   template="Tonyapps_StockNotification::guest/token_action.phtml" cacheable="false">
                <arguments>
                    <argument name="action_path" xsi:type="string">stocknotification/guest/unsubscribe</argument>
                    <argument name="question" xsi:type="string" translate="true">Stop emails about this product?</argument>
                    <argument name="button" xsi:type="string" translate="true">Stop alerts</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
